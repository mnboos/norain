{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run type-check && npm run build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix",
        "format": "prettier --write src/",
        "update:api:export_schema": "cd ../backend && call .venv/scripts/activate && task export_openapi_schema",
        "update:api:generate_client": "openapi-generator-cli generate -g typescript-fetch -i ../backend/api_schema.json --remove-operation-id-prefix -o src/api/ --additional-properties=useSingleRequestParameter=true,supportsES6=true,disallowAdditionalPropertiesIfNotPresent=false",
        "update:api": "npm run update:api:export_schema && npm run update:api:generate_client"
    },
    "dependencies": {
        "@fontsource-variable/lexend": "5.3.0",
        "@norain/api": "file:../packages/api",
        "@quasar/extras": "2.1.0",
        "@tanstack/vue-query": "5.102.8",
        "@vueuse/core": "14.4.0",
        "maplibre-gl": "6.9.0",
        "plotly.js": "^4.1.0",
        "quasar": "2.32.3",
        "vue": "3.5.42",
        "vue-router": "5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@quasar/vite-plugin": "2.0.2",
        "@tanstack/eslint-plugin-query": "5.102.8",
        "@tanstack/vue-query-devtools": "6.1.48",
        "@tsconfig/node22": "22.0.6",
        "@types/jsdom": "30.0.0",
        "@types/node": "26.5.1",
        "@types/plotly.js": "^3.0.13",
        "@vitejs/plugin-vue": "6.0.9",
        "@vitest/eslint-plugin": "1.6.27",
        "@vue/eslint-config-prettier": "10.2.0",
        "@vue/eslint-config-typescript": "14.9.0",
        "@vue/test-utils": "2.5.0",
        "@vue/tsconfig": "0.9.1",
        "eslint": "10.10.0",
        "eslint-plugin-playwright": "2.12.0",
        "eslint-plugin-vue": "10.11.0",
        "jiti": "2.7.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.0",
        "vite-plugin-vue-devtools": "8.2.1",
        "vitest": "5.0.0",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.11"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": false,
        "printWidth": 120,
        "arrowParens": "avoid",
        "endOfLine": "lf",
        "htmlWhitespaceSensitivity": "ignore"
    }
}
