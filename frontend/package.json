{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --port 3000",
        "build": "npm run type-check && npm run build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix",
        "format": "prettier --write src/",
        "update:api:export_schema": "cd ../backend && call .venv/scripts/activate && task export_openapi_schema",
        "update:api:generate_client": "openapi-generator-cli generate -g typescript-fetch -i ../backend/api_schema.json --remove-operation-id-prefix -o src/api/ --additional-properties=useSingleRequestParameter=true,supportsES6=true,disallowAdditionalPropertiesIfNotPresent=false",
        "update:api": "npm run update:api:export_schema && npm run update:api:generate_client"
    },
    "dependencies": {
        "@norain/api": "file:../packages/api",
        "@quasar/extras": "2.0.4",
        "@tanstack/vue-query": "5.102.8",
        "maplibre-gl": "6.9.0",
        "plotly.js": "^4.1.0",
        "quasar": "2.20.1",
        "vue": "3.5.38",
        "vue-router": "5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.61.0",
        "@quasar/vite-plugin": "1.12.0",
        "@tanstack/eslint-plugin-query": "5.101.0",
        "@tanstack/vue-query-devtools": "6.1.34",
        "@tsconfig/node22": "22.0.5",
        "@types/jsdom": "28.0.3",
        "@types/node": "25.9.3",
        "@vitejs/plugin-vue": "6.0.7",
        "@vitest/eslint-plugin": "1.6.20",
        "@vue/eslint-config-prettier": "10.2.0",
        "@vue/eslint-config-typescript": "14.8.0",
        "@vue/test-utils": "2.4.11",
        "@vue/tsconfig": "0.9.1",
        "eslint": "10.5.0",
        "eslint-plugin-playwright": "2.10.4",
        "eslint-plugin-vue": "10.9.2",
        "jiti": "2.7.0",
        "jsdom": "29.1.1",
        "prettier": "3.8.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.61.1",
        "vite": "8.0.16",
        "vite-plugin-vue-devtools": "8.1.3",
        "vitest": "4.1.9",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.5"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": false,
        "printWidth": 120,
        "arrowParens": "avoid",
        "endOfLine": "lf",
        "htmlWhitespaceSensitivity": "ignore"
    }
}
