# Copy to a root-owned .env beside docker-compose.prod.yml on the VPS.
# Use strong, unique secrets. Do not commit the populated file.
COMPOSE_FILE=docker-compose.prod.yml
DOMAIN=norain.example.com
ACME_EMAIL=ops@example.com
DJANGO_SETTINGS_MODULE=backend.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=${DOMAIN}
DJANGO_CSRF_TRUSTED_ORIGINS=https://${DOMAIN}
# The admin is served at https://DOMAIN/<this>/. Pick something not guessable, e.g. the
# output of `openssl rand -hex 8`; production refuses to start without it or with "admin".
DJANGO_ADMIN_PATH=replace-with-a-random-slug
FRONTEND_URL=https://${DOMAIN}

# Absolute host directory for all persistent bind-mounted service data.
APP_STORAGE_PATH=/srv/norain-data

DB_NAME=norain
DB_HOST=db
DB_PORT=5432
DB_USER=norain
DB_PASSWORD=replace-with-a-long-random-password

GEOCODER_API_URL=http://photon:2322/api
GRAPHHOPPER_API_URL=http://graphhopper:8989
OPENWEATHERMAP_API_KEY=
WEATHERUNDERGROUND_API_KEY=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="NoRain <mailer@example.com>"

# Optional billing: leave empty to run without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# GraphHopper builds its graph from OSM_DATA_URL when APP_STORAGE_PATH/graphhopper/cache is
# empty, then serves it. To rebuild: stop graphhopper, empty the cache, start it again.
# GRAPHHOPPER_MEM_LIMIT caps the container while it builds too, so it must fit the build heap.
# Switzerland: build heap 6g, serving heap 3g. DACH: build heap 16-24g, serving heap = graph
# directory size + ~2 GB (roughly 10-14g), or GRAPHHOPPER_DATAACCESS=MMAP with a 3g heap.
# If the VPS cannot hold the build, build the graph elsewhere, copy it into the cache and set
# GRAPHHOPPER_BUILD_GRAPH=false (docs/how-to/build-routing-graph.md).
OSM_DATA_URL=https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
GRAPHHOPPER_BUILD_HEAP=6g
GRAPHHOPPER_HEAP=3g
GRAPHHOPPER_MEM_LIMIT=8g
GRAPHHOPPER_DATAACCESS=RAM_STORE
# Artifact to download manually; see docs/how-to/deploy-vps.md. Production never downloads it.
PHOTON_INDEX_URL=https://download1.graphhopper.com/public/europe/switzerland-liechtenstein/photon-dump-switzerland-liechtenstein-1.0-latest.jsonl.zst
PHOTON_IMPORT_HEAP=4g

# Encrypted offsite backup repository. Store the password in the root-owned file
# referenced by RESTIC_PASSWORD_FILE, never in this environment file.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/example-bucket/norain
RESTIC_PASSWORD_FILE=/etc/norain/restic-password

# Immutable GHCR image references, updated by the release workflow.
BACKEND_IMAGE=ghcr.io/mnboos/norain-backend:REPLACE_WITH_COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/mnboos/norain-frontend:REPLACE_WITH_COMMIT_SHA
GRAPHHOPPER_IMAGE=ghcr.io/mnboos/norain-graphhopper:REPLACE_WITH_COMMIT_SHA
PHOTON_IMAGE=ghcr.io/mnboos/norain-photon:REPLACE_WITH_COMMIT_SHA
