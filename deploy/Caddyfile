{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    @health path /healthz
    reverse_proxy @health backend:8000

    handle_path /static/* {
        root * /app/static
        file_server
    }

    @backend path /api/* /admin/* /accounts/*
    reverse_proxy @backend backend:8000 {
        transport http {
            read_timeout 120s
            write_timeout 120s
        }
    }

    try_files {path} /index.html
    file_server
}
