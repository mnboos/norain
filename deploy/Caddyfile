{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    handle_path /static/* {
        root * /app/static
        file_server
    }

    @backend path /healthz /api/* /{$DJANGO_ADMIN_PATH}/* /accounts/* /ws/*
    handle @backend {
        reverse_proxy backend:8000 {
            # The only client address Django trusts (login lockout). {client_ip} honours
            # trusted_proxies, and header_up overwrites whatever the client sent.
            header_up X-Real-IP {client_ip}
            transport http {
                read_timeout 120s
                write_timeout 120s
            }
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
