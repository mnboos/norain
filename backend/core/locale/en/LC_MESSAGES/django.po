#: .\core\templates\account\email\account_already_exists_message.txt:1
#, python-format
msgid ""
"Hallo\n"
"\n"
"Jemand – hoffentlich du – wollte mit %(email)s ein Konto bei %(site_name)s "
"erstellen. Für diese Adresse gibt es aber schon eines.\n"
"\n"
"Melde dich mit einem Code an, den wir dir per E-Mail schicken:"
msgstr ""
"Hello\n"
"\n"
"Someone – hopefully you – tried to create an account at %(site_name)s with "
"%(email)s. But there already is one for this address.\n"
"\n"
"Sign in with a code we send you by email:"

#: .\core\templates\account\email\account_already_exists_message.txt:9
#: .\core\templates\account\email\login_code_message.txt:9
msgid "Warst du das nicht? Dann kannst du diese E-Mail ignorieren."
msgstr "Wasn't you? Then you can ignore this email."

#: .\core\templates\account\email\account_already_exists_subject.txt:1
msgid "Du hast bereits ein Konto"
msgstr "You already have an account"

#: .\core\templates\account\email\email_confirmation_signup_message.txt:1
#, python-format
