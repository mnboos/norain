{
    "openapi": "3.1.0",
    "info": {
        "title": "NoRain API",
        "version": "1.0.0",
        "description": ""
    },
    "paths": {
        "/api/route_weather": {
            "get": {
                "operationId": "core_api_route_weather_route_weather",
                "summary": "Route Weather",
                "parameters": [
                    {
                        "in": "query",
                        "name": "start_lat",
                        "schema": {
                            "title": "Start Lat",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "start_lon",
                        "schema": {
                            "title": "Start Lon",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "dest_lat",
                        "schema": {
                            "title": "Dest Lat",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "dest_lon",
                        "schema": {
                            "title": "Dest Lon",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "profile",
                        "schema": {
                            "title": "Profile",
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "departure_time",
                        "schema": {
                            "title": "Departure Time",
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "interval_seconds",
                        "schema": {
                            "default": 300,
                            "title": "Interval Seconds",
                            "type": "integer"
                        },
                        "required": false
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RouteWeatherOut"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "Route weather"
                ]
            }
        },
        "/api/routes": {
            "get": {
                "operationId": "core_api_recurring_route_list_routes",
                "summary": "List Routes",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/RecurringRouteOut"
                                    },
                                    "title": "Response",
                                    "type": "array"
                                }
                            }
                        }
                    }
                },
                "description": "List the current account's active recurring routes by next departure.",
                "tags": [
                    "Recurring routes"
                ]
            },
            "post": {
                "operationId": "core_api_recurring_route_create_route",
                "summary": "Create Route",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RecurringRouteOut"
                                }
                            }
                        }
                    }
                },
                "description": "Create a new recurring route. Enqueues a background task to fetch route geometry.",
                "tags": [
                    "Recurring routes"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RecurringRouteIn"
                            }
                        }
                    },
                    "required": true
                }
            }
        },
        "/api/routes/{route_id}": {
            "get": {
                "operationId": "core_api_recurring_route_get_route",
                "summary": "Get Route",
                "parameters": [
                    {
                        "in": "path",
                        "name": "route_id",
                        "schema": {
                            "format": "uuid",
                            "title": "Route Id",
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RecurringRouteOut"
                                }
                            }
                        }
                    }
                },
                "description": "Get a single recurring route by ID.",
                "tags": [
                    "Recurring routes"
                ]
            },
            "put": {
                "operationId": "core_api_recurring_route_update_route",
                "summary": "Update Route",
                "parameters": [
                    {
                        "in": "path",
                        "name": "route_id",
                        "schema": {
                            "format": "uuid",
                            "title": "Route Id",
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RecurringRouteOut"
                                }
                            }
                        }
                    }
                },
                "description": "Update a recurring route. Re-fetches geometry if start, destination, or profile changed.",
                "tags": [
                    "Recurring routes"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RecurringRouteIn"
                            }
                        }
                    },
                    "required": true
                }
            },
            "delete": {
                "operationId": "core_api_recurring_route_delete_route",
                "summary": "Delete Route",
                "parameters": [
                    {
                        "in": "path",
                        "name": "route_id",
                        "schema": {
                            "format": "uuid",
                            "title": "Route Id",
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                },
                "description": "Delete a recurring route.",
                "tags": [
                    "Recurring routes"
                ]
            }
        },
        "/api/routes/{route_id}/forecast": {
            "get": {
                "operationId": "core_api_recurring_route_route_forecast",
                "summary": "Route Forecast",
                "parameters": [
                    {
                        "in": "path",
                        "name": "route_id",
                        "schema": {
                            "format": "uuid",
                            "title": "Route Id",
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "date",
                        "schema": {
                            "title": "Date",
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "time",
                        "schema": {
                            "title": "Time",
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RouteForecastOut"
                                }
                            }
                        }
                    }
                },
                "description": "Get weather forecast + Plotly figures for a specific departure of a saved route.\n\nAssembles the forecast from cached grid cells (ForecastCell + EnsembleCell).\nIf cells are missing, they are fetched on-the-fly and stored.",
                "tags": [
                    "Recurring routes"
                ]
            }
        },
        "/api/search": {
            "get": {
                "operationId": "core_api_places_search",
                "summary": "Search",
                "parameters": [
                    {
                        "in": "query",
                        "name": "query",
                        "schema": {
                            "title": "Query",
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "zoom",
                        "schema": {
                            "title": "Zoom",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "lat",
                        "schema": {
                            "title": "Lat",
                            "type": "number"
                        },
                        "required": true
                    },
                    {
                        "in": "query",
                        "name": "lon",
                        "schema": {
                            "title": "Lon",
                            "type": "number"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/PlacesSearchResult"
                                    },
                                    "title": "Response",
                                    "type": "array"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "Places"
                ]
            }
        }
    },
