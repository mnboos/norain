COMPOSE_FILE=docker-compose.dev.yml

# Local image tags for production builds with `docker compose build`.
# On the VPS, use COMPOSE_FILE=docker-compose.prod.yml and the production settings
# from deploy/production.env.template.
BACKEND_IMAGE=norain-backend:local
FRONTEND_IMAGE=norain-frontend:local
GRAPHHOPPER_IMAGE=norain-graphhopper:local
PHOTON_IMAGE=norain-photon:local

# --- Local ports. Change one here if something else already uses it, then restart. ---
# Compose publishes the containers on these host ports, Django connects to them, Vite serves
# and proxies on them, and the SPA reaches the backend on BACKEND_PORT. Keep this block above
# the URLs below: they interpolate these values.
DB_PORT=5432
REDIS_PORT=6379
GRAPHHOPPER_PORT=8989
PHOTON_PORT=2322
BACKEND_PORT=8000
FRONTEND_PORT=3000

APP_STORAGE_PATH=.

DB_NAME=norain
DB_HOST=127.0.0.1
DB_USER=norain
DB_PASSWORD=local-development-only

# macOS: Homebrew's libgdal/libgeos_c (brew install gdal) are found automatically.
# Windows/OSGeo4W only; uncomment and adjust if the libraries are not auto-detected.
# GDAL_LIBRARY_PATH=C:/Users/you/AppData/Local/Programs/OSGeo4W/bin/gdal312.dll
# GEOS_LIBRARY_PATH=C:/Users/you/AppData/Local/Programs/OSGeo4W/bin/geos_c.dll

TZ=Europe/Zurich

# Redis backs two things: the in-flight claim that stops one grid cell being fetched by
# several tasks at once, and the channel layer that carries forecast progress from the
# workers to the browser's WebSocket. Both the web process and every worker need it.
REDIS_URL=redis://127.0.0.1:${REDIS_PORT:-6379}

GEOCODER_API_URL=http://127.0.0.1:${PHOTON_PORT:-2322}/api/

# GraphHopper routing service (point-to-point routing for the weather feature)
GRAPHHOPPER_API_URL=http://127.0.0.1:${GRAPHHOPPER_PORT:-8989}

# Weather: Open-Meteo is the primary source and needs no key.
# OpenWeatherMap One Call 3.0 is used only as a fallback / cross-check.
# Weather Underground (free PWS owner key) corrects the first hours of Pro forecasts
# with nearby weather stations. Leave empty to turn that off.
OPENWEATHERMAP_API_KEY=
WEATHERUNDERGROUND_API_KEY=

# Development only: false opens the local admin with the password alone, without the
# authenticator code. Production settings ignore it.
DJANGO_ADMIN_OTP=true

# --- OSM extract (coverage area). Change these to route/geocode outside Switzerland. ---
# GraphHopper OSM extract (any Geofabrik .osm.pbf). The graph is built from it when
# data/graphhopper/cache is empty; empty the cache to build it again. Larger extracts need a
# bigger build heap and more RAM/disk.
OSM_DATA_URL=https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
# GRAPHHOPPER_HEAP=6g
# GRAPHHOPPER_BUILD_HEAP=
# GRAPHHOPPER_DATAACCESS=RAM_STORE
# Photon data matching the area above. Browse https://download1.graphhopper.com/public/ — the
# version token must be "1.0" to match the photon-1.0.1.jar. Two artifact types are supported:
#   * country/region:   .../photon-dump-<region>-1.0-latest.jsonl.zst  (imported on first boot, ~minutes)
#   * continent/planet: .../photon-db-<region>-1.0-latest.tar.bz2      (prebuilt index, just extracted)
PHOTON_INDEX_URL=https://download1.graphhopper.com/public/europe/switzerland-liechtenstein/photon-dump-switzerland-liechtenstein-1.0-latest.jsonl.zst
# JVM heap for the JSONL import step; raise for larger regions.
PHOTON_IMPORT_HEAP=4g

# `just deploy [sha]` only: the VPS to release to over SSH (see docs/how-to/deploy-vps.md).
# VPS_USER=norain
# VPS_HOST=norain.example.com
# VPS_PUBLIC_HEALTH_URL=https://norain.example.com/healthz

ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# Windows only
#GDAL_LIBRARY_PATH=c:/users/mboos/appdata/local/Programs/OSGeo4W/bin/gdal312.dll
#GEOS_LIBRARY_PATH=c:/users/mboos/appdata/local/Programs/OSGeo4W/bin/geos_c.dll
#LIB=c:/users/mboos/appdata/local/programs/osgeo4w/lib
#INCLUDE=c:/users/mboos/appdata/localprograms/osgeo4w/include
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
LIB=
INCLUDE=

# Sentry. Empty DSNs leave it off. The backend reports only under production settings; the
# frontend DSN is baked into the bundle when Vite builds or serves it.
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
# Only to upload frontend source maps to Sentry, from `npm run build` or `docker compose build`
# (SENTRY_RELEASE: `just deploy-local` sets it to the commit). Without a token no source maps
# are written.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_FRONTEND=
# SENTRY_RELEASE=

# Freemium beta: trial and complimentary access work without Stripe.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS_ANNUAL=
STRIPE_PRICE_ID_PLUS_MONTHLY=
BRIEFING_EMAIL_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
