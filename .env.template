COMPOSE_FILE=docker-compose.dev.yml

APP_STORAGE_PATH=.

DB_NAME=norain
DB_HOST=localhost
DB_PORT=5432
DB_USER=norain
DB_PASSWORD=local-development-only

# Windows/OSGeo4W only; uncomment and adjust if the libraries are not auto-detected.
# GDAL_LIBRARY_PATH=C:/Users/you/AppData/Local/Programs/OSGeo4W/bin/gdal312.dll
# GEOS_LIBRARY_PATH=C:/Users/you/AppData/Local/Programs/OSGeo4W/bin/geos_c.dll

TZ=Europe/Zurich

GEOCODER_API_URL=http://localhost:2322/api/

# GraphHopper routing service (point-to-point routing for the weather feature)
GRAPHHOPPER_API_URL=http://localhost:8989

# Weather: Open-Meteo is the primary source and needs no key.
# OpenWeatherMap One Call 3.0 is used only as a fallback / cross-check.
OPENWEATHERMAP_API_KEY=

# --- OSM extract (coverage area). Change these to route/geocode outside Switzerland. ---
# GraphHopper OSM extract (any Geofabrik .osm.pbf: a country, continent, or the planet).
# Larger extracts need a bigger JVM heap (docker/graphhopper-entrypoint.sh) and more RAM/disk.
OSM_DATA_URL=https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
# Photon data matching the area above. Browse https://download1.graphhopper.com/public/ — the
# version token must be "1.0" to match the photon-1.0.1.jar. Two artifact types are supported:
#   * country/region:   .../photon-dump-<region>-1.0-latest.jsonl.zst  (imported on first boot, ~minutes)
#   * continent/planet: .../photon-db-<region>-1.0-latest.tar.bz2      (prebuilt index, just extracted)
PHOTON_INDEX_URL=https://download1.graphhopper.com/public/europe/switzerland-liechtenstein/photon-dump-switzerland-liechtenstein-1.0-latest.jsonl.zst
# JVM heap for the JSONL import step; raise for larger regions.
PHOTON_IMPORT_HEAP=4g

ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
